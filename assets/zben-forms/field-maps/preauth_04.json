      },

      { "type": "centered", "source": "request", "field": "crtby_attendingqynecologiconcologist", "decrypt": true, "x": 8,   "y": 118.5, "w": 100, "fontsize": 6 },
      { "type": "centered", "source": "request", "field": "crtby_medicaldirectory",               "decrypt": true, "x": 115, "y": 118.5, "w": 90,  "fontsize": 6 },
      { "type": "boxed",    "source": "request", "field": "crtby_attendingqynecologiconcologist_accreno", "decrypt": true, "x": 47.5,  "y": 143, "pitch": 4.15 },
      { "type": "boxed",    "source": "request", "field": "crtby_medicaldirectory_accreno",               "decrypt": true, "x": 134.0, "y": 143, "pitch": 4.15 },
      { "type": "centered", "source": "request", "field": "crtby_patient", "decrypt": true, "x": 118, "y": 155.5, "w": 88, "fontsize": 7 }
    ]
  }
