{
  "preauth_type": 4,
  "illness": "Cervical Cancer",
  "template": "PreAuth_04.pdf",
  "pages": {
    "1": [
      { "type": "fullname",  "source": "patientinfo", "prefix": "patient", "x": 50, "y": 73, "w": 98, "fontsize": 7 },
      { "type": "checkbox",  "source": "patientinfo", "field": "patient_sex", "match": "M", "x": 153, "y": 75, "fontsize": 9 },
      { "type": "checkbox",  "source": "patientinfo", "field": "patient_sex", "match": "F", "x": 167, "y": 75, "fontsize": 9 },
      { "type": "boxed",     "source": "patientinfo", "field": "patient_philhealthno", "x": 107.6, "y": 80, "pitch": 5.55 },

      { "type": "member_toggle", "source": "patientinfo", "conditionField": "patient_is_member", "match": "Y",
        "same": { "type": "mark", "x": 53, "y": 89, "fontsize": 9 },
        "different": {
          "member_name": { "type": "fullname", "source": "patientinfo", "prefix": "member", "x": 50, "y": 96, "w": 98, "fontsize": 7 },
