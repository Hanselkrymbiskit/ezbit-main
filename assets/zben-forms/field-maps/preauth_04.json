        }
      },

      { "type": "checkbox", "source": "patientinfo", "field": "fulfilled_selection_criteria", "match": "Y", "x": 82, "y": 111.5, "fontsize": 9 },
      { "type": "checkbox", "source": "patientinfo", "field": "fulfilled_selection_criteria", "match": "N", "x": 82, "y": 119.5, "fontsize": 9 },
      { "type": "text",     "source": "patientinfo", "field": "fulfilled_selection_criteria_reason", "x": 95, "y": 126, "fontsize": 9 },

      { "type": "checkbox", "source": "checklist", "field": "q_1_1", "x": 163, "y": 156, "fontsize": 9 },
      { "type": "checkbox", "source": "checklist", "field": "q_1_2", "x": 163, "y": 161, "fontsize": 9 },
      { "type": "checkbox", "source": "checklist", "field": "q_1_3", "x": 163, "y": 166, "fontsize": 9 },
      { "type": "checkbox", "source": "checklist", "field": "q_1_4", "x": 163, "y": 171, "fontsize": 9 },
      { "type": "checkbox", "source": "checklist", "field": "q_1_5", "x": 163, "y": 176, "fontsize": 9 },

      { "type": "radio", "source": "checklist", "field": "q_2_1", "fontsize": 9,
        "options": { "1": [103, 197], "2": [103, 202], "3": [103, 207], "4": [103, 211.5], "5": [103, 216.5], "6": [103, 221.5], "7": [103, 226.5], "8": [103, 231.5], "9": [103, 236.5] },
        "note": "q_2_1_date is written by a small coupled PHP snippet right after this call (needs the SAME row Y as whichever stage was picked -- not expressible as a flat field in this schema)."
      },

      { "type": "centered", "source": "checklist", "field": "crtby_attendingqynecologiconcologist", "decrypt": true, "x": 116, "y": 248, "w": 68, "fontsize": 7 },
      { "type": "boxed",    "source": "checklist", "field": "crtby_attendingqynecologiconcologist_accreno", "decrypt": true, "x": 126.9, "y": 260, "pitch": 4.15 }
    ],
    "3": [
      { "type": "date",     "source": "patientinfo", "field": "submitted_datetime", "x": 135, "y": 44, "fontsize": 9 },
      { "type": "fullname", "source": "patientinfo", "prefix": "patient", "x": 20, "y": 58, "w": 45, "fontsize": 9 },
      { "type": "facility_name", "source": "patientinfo", "x": 75, "y": 58, "w": 110, "fontsize": 9 },

      { "type": "checkbox", "source": "request", "field": "copayment", "match": "wocp", "x": 27.6, "y": 95, "fontsize": 9 },
      { "type": "checkbox", "source": "request", "field": "copayment", "match": "wcp", "x": 27.6, "y": 99, "fontsize": 9 },
      { "type": "text",     "source": "request", "field": "with_copayment_purpose", "decrypt": true, "x": 30, "y": 112.5, "fontsize": 9 },

      { "type": "radio", "source": "request", "field": "treatmentmodality", "fontsize": 9,
