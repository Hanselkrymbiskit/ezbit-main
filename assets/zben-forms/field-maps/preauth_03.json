      { "type": "boxed",    "source": "checklist", "field": "crtby_attendingcardiologist_accreno", "decrypt": true, "x": 47.5, "y": 162.7, "pitch": 4.15 },
      { "type": "boxed",    "source": "checklist", "field": "crtby_attendingcardiovascularsurgeon_accreno", "decrypt": true, "x": 134.0, "y": 162.7, "pitch": 4.15 },
