      { "type": "text",     "source": "patientinfo", "field": "fulfilled_selection_criteria_reason", "x": 95, "y": 140, "fontsize": 9 },

      { "type": "checkbox", "source": "checklist", "field": "q_1_age", "match": "Y", "x": 167, "y": 173, "fontsize": 9 },
