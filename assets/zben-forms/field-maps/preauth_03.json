{
  "preauth_type": 3,
  "illness": "CABG",
  "template": "PreAuth_03.pdf",
  "pages": {
    "1": [
      { "type": "fullname",  "source": "patientinfo", "prefix": "patient", "x": 50, "y": 83.5, "w": 98, "fontsize": 7 },
      { "type": "checkbox",  "source": "patientinfo", "field": "patient_sex", "match": "M", "x": 153, "y": 83.5, "fontsize": 9 },
      { "type": "checkbox",  "source": "patientinfo", "field": "patient_sex", "match": "F", "x": 169, "y": 83.5, "fontsize": 9 },
      { "type": "boxed",     "source": "patientinfo", "field": "patient_philhealthno", "x": 107.6, "y": 90, "pitch": 5.55 },

      { "type": "member_toggle", "source": "patientinfo", "conditionField": "patient_is_member", "match": "Y",
        "same": { "type": "mark", "x": 52.5, "y": 97.5, "fontsize": 9 },
        "different": {
          "member_name": { "type": "fullname", "source": "patientinfo", "prefix": "member", "x": 50, "y": 107, "w": 98, "fontsize": 7 },
