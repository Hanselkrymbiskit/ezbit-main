      { "type": "checkbox", "source": "checklist", "field": "q_2_4",   "match": "Y", "x": 167, "y": 62.5, "fontsize": 9 },

      { "type": "checkbox", "source": "checklist", "field": "q_3_1", "match": "Y", "x": 150, "y": 97, "fontsize": 9 },
      { "type": "date",     "source": "checklist", "field": "q_3_1_date", "x": 172, "y": 97, "fontsize": 9 },
      { "type": "checkbox", "source": "checklist", "field": "q_3_2", "match": "Y", "x": 150, "y": 109.5, "fontsize": 9 },
      { "type": "date",     "source": "checklist", "field": "q_3_2_date", "x": 172, "y": 109.5, "fontsize": 9 },

      { "type": "centered", "source": "checklist", "field": "crtby_attendingcardiologist", "decrypt": true, "x": 8, "y": 146.5, "w": 100, "fontsize": 6 },
