      { "type": "text",     "source": "request", "field": "with_copayment_purpose", "decrypt": true, "x": 95, "y": 103, "fontsize": 9 },

      { "type": "centered", "source": "request", "field": "crtby_attendingcardiologist", "decrypt": true, "x": 8, "y": 119, "w": 100, "fontsize": 6 },
      { "type": "centered", "source": "request", "field": "crtby_attendingcardiovascularsurgeon", "decrypt": true, "x": 115, "y": 119, "w": 90, "fontsize": 6 },
      { "type": "boxed",    "source": "request", "field": "crtby_attendingcardiologist_accreno", "decrypt": true, "x": 47.5, "y": 135.5, "pitch": 4.15 },
      { "type": "boxed",    "source": "request", "field": "crtby_attendingcardiovascularsurgeon_accreno", "decrypt": true, "x": 134.0, "y": 135.5, "pitch": 4.15 },

      { "type": "centered", "source": "request", "field": "crtby_patient", "decrypt": true, "x": 8, "y": 150, "w": 100, "fontsize": 7 },
      { "type": "centered", "source": "request", "field": "crtby_medicaldirectory", "decrypt": true, "x": 115, "y": 150, "w": 90, "fontsize": 6 },
      { "type": "boxed",    "source": "request", "field": "crtby_medicaldirectory_accreno", "decrypt": true, "x": 134.0, "y": 168, "pitch": 4.15 }
